# Browser-safe Supabase settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Vercel server-only secrets — NEVER prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional protected QR email settings
GMAIL_SENDER=your-admin@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
ADMIN_INVITE_REDIRECT_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/
