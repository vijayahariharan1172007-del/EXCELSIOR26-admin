# Browser-safe Supabase settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Vercel server-only secrets — NEVER prefix these with VITE_
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional protected QR email settings
GMAIL_SENDER=your-admin@gmail.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Admin overlay authentication — server only
ADMIN_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SERVER_SECRET

# Owner-only credential PDF source. JSON with the 10 generated users/passwords.
ADMIN_CREDENTIALS_JSON=[{"username":"exc26admin01","password":"REPLACE","role":"owner"}]
